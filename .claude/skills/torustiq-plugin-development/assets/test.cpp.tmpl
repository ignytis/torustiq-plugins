TEST_F({{Class}}Test, ReportsInfoAndRegisters) {
    const torustiq_plugin_info* info = torustiq_plugin_get_info();
    EXPECT_STREQ(info->id, "{{ID}}");
    EXPECT_EQ(info->abi_version, TORUSTIQ_SDK_ABI_VERSION);
    EXPECT_STREQ(vtable().name, "{{ID}}");
}

TEST_F({{Class}}Test, StepsGetIndependentHandles) {
    // Use valid config; an empty config only works for plugins without required keys.
    const torustiq_header items[] = {{"n", "1"}};
    const torustiq_config config{items, 1};
    void* a = nullptr;
    void* b = nullptr;
    ASSERT_EQ(vtable().create(&config, &a), TORUSTIQ_OK);
    ASSERT_EQ(vtable().create(&config, &b), TORUSTIQ_OK);
    EXPECT_NE(a, b);
    vtable().destroy(a);
    vtable().destroy(b);
}

// --- Plugins with config: validation ---
TEST_F({{Class}}Test, RejectsInvalidConfig) {
    for (const char* bad : {"0", "-1", "abc", "", "1.5", "99999999999999999999999"}) {
        const torustiq_header items[] = {{"n", bad}};
        const torustiq_config config{items, 1};
        void* handle = nullptr;
        EXPECT_EQ(vtable().create(&config, &handle), TORUSTIQ_ERROR) << "n=" << bad;
    }
    const torustiq_config empty{nullptr, 0};
    void* handle = nullptr;
    EXPECT_EQ(vtable().create(&empty, &handle), TORUSTIQ_ERROR);
}

